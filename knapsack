#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

// Function to solve the 0/1 Knapsack problem
int knapsack(int W, const vector<int>& weights, const vector<int>& values, int n) {
    // Create a 2D table to store computed maximum values
    // Rows represent items, Columns represent weight capacity from 0 to W
    vector<vector<int>> dp(n + 1, vector<int>(W + 1, 0));

    // Build the table in a bottom-up manner
    for (int i = 1; i <= n; i++) {
        for (int w = 1; w <= W; w++) {
            // Check if the current item's weight can fit in the bag
            if (weights[i - 1] <= w) {
                // Max of: including the item OR excluding the item
                dp[i][w] = max(values[i - 1] + dp[i - 1][w - weights[i - 1]], 
                               dp[i - 1][w]);
            } else {
                // If it doesn't fit, skip it (keep the previous max value)
                dp[i][w] = dp[i - 1][w];
            }
        }
    }

    // The bottom-right cell contains the final answer
    return dp[n][W];
}

int main() {
    // Example Data
    vector<int> values = {60, 100, 120};
    vector<int> weights = {10, 20, 30};
    int W = 50; // Total weight limit of the bag
    int n = values.size(); // Number of items

    cout << "Maximum value in Knapsack = " << knapsack(W, weights, values, n) << endl;

    return 0;
}
